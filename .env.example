APP_NAME=CajeerEngine
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_KEY=base64:CHANGE_ME
JWT_SECRET=CHANGE_ME
API_TOKEN_SECRET=CHANGE_ME
WEBHOOK_SIGNING_SECRET=CHANGE_ME
APP_LOCALE=ru

DB_DRIVER=pgsql
# Для demo/local можно поставить DB_DRIVER=sqlite и SQLITE_DATABASE=storage/database/cajeer.sqlite
SQLITE_DATABASE=storage/database/cajeer.sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cajeerengine
DB_USERNAME=cajeerengine
DB_PASSWORD=secret
DB_SSLMODE=prefer

# Optional DB drivers: mysql, mariadb
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci

CACHE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

QUEUE_DRIVER=file

SEARCH_DRIVER=file
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
OPENSEARCH_HOST=http://127.0.0.1:9200

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage/app
STORAGE_PUBLIC_UPLOADS_URL=/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true


RATE_LIMIT_GLOBAL=120
RATE_LIMIT_AUTH=20
RATE_LIMIT_ANALYTICS=60

APP_VERSION=1.5.6
LOG_RUNTIME=true
CONTENT_STORAGE=database
CMS_STORAGE=database

# Optional first admin for php bin/cajeer db:seed
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Security Core 0.5.0
SECURITY_REQUIRE_AUTH=true
SECURITY_PROTECT_CONTENT_WRITES=true
SECURITY_PROTECT_SYSTEM_ROUTES=true
RATE_LIMIT_WINDOW_SECONDS=60
SESSION_TTL_DAYS=14
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_MIXED=true
PASSWORD_ARGON2_MEMORY=65536
PASSWORD_ARGON2_TIME=4
PASSWORD_ARGON2_THREADS=2


# Admin UI 1.1.4
ADMIN_PUBLIC_BASE=/admin/
ADMIN_API_BASE=/api/v1
ADMIN_PREBUILT_ASSETS=true

# CMS Public Layer 1.1.4
PUBLIC_DEFAULT_TEMPLATE=default.page
TEMPLATE_CACHE=true
MEDIA_STORAGE=file
MEDIA_MAX_UPLOAD_MB=25
MEDIA_REQUIRE_IMAGE_PROCESSOR=false
# Install ext-gd, or configure an absolute ImageMagick convert binary.
# MEDIA_CONVERT_BINARY=/usr/bin/convert
MEDIA_ALLOW_SVG=false


# Queue/Scheduler/Search/Webhooks 0.8.0
QUEUE_WORKER_LIMIT=10
QUEUE_LEASE_SECONDS=300
QUEUE_JOB_TIMEOUT_SECONDS=120
SCHEDULER_DRIVER=file
QUEUE_REDIS_PREFIX=ce:queue:
QUEUE_RETRY_BACKOFF=60
RABBITMQ_DSN=amqp://guest:guest@127.0.0.1:5672/%2f
RABBITMQ_EXCHANGE=cajeerengine.jobs
RABBITMQ_QUEUE_PREFIX=cajeerengine
SEARCH_DRIVER=file
WEBHOOK_TIMEOUT_SECONDS=10
SCHEDULER_ENABLE_SEARCH_INDEX=true
SCHEDULER_ENABLE_WEBHOOK_DISPATCH=true


# Extension System 1.0.6
EXTENSIONS_ALLOW_UNSIGNED_IN_DEV=false
EXTENSIONS_REQUIRE_SIGNATURE=true
EXTENSIONS_TRUST_DIR=
# Updates / Releases
# GitHub endpoints are built into core for https://github.com/cajeerteam/CajeerEngine
UPDATE_CHANNEL=stable
UPDATE_HTTP_TIMEOUT=5
UPDATE_SIGNATURE_REQUIRED=true
# Web Upgrade is disabled by default; prefer CLI update in production.
UPDATE_WEB_UPGRADE_ENABLED=false
# Public trust key and backup encryption key are provisioned outside the project.
UPDATE_TRUSTED_PUBLIC_KEY_FILE=
BACKUP_KEY_FILE=
# Optional independent SQLite recovery interpreter (only if pdo_sqlite unavailable).
BACKUP_SQLITE_PYTHON=
# Set only after a successful disposable MySQL/MariaDB restore rehearsal.
BACKUP_MYSQL_RESTORE_CONFIRMED=false

# Installer / Import Export
IMPORT_EXPORT_MAX_BYTES=52428800

# Local HTML render cache: disabled by default; preview and signed themes bypass it.
PUBLIC_RENDER_CACHE_TTL=0

# Database session limits
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
DB_MYSQL_LOCK_TIMEOUT_SECONDS=5
DB_SQLITE_BUSY_TIMEOUT_MS=5000
DB_SQLITE_WAL=false

# Observability (generate a dedicated random secret; never reuse an API token)
OBSERVABILITY_METRICS_TOKEN=
OBSERVABILITY_MIN_FREE_BYTES=104857600
OBSERVABILITY_BACKUP_MAX_AGE=86400
OBSERVABILITY_WORKER_MAX_AGE=300
OBSERVABILITY_QUEUE_MAX_AGE=300
OBSERVABILITY_LOG_MAX_BYTES=10485760
# Optional OTLP/HTTP JSON collector, full /v1/traces URL.
OBSERVABILITY_OTLP_ENDPOINT=
OBSERVABILITY_OTLP_TOKEN=
OBSERVABILITY_TRACE_SAMPLE_RATE=0.1

# Integration Center (key defaults to APP_KEY; preserve with backups)
INTEGRATIONS_ENABLED=true
INTEGRATIONS_KEY=
# Decrypt-only previous encryption keys, comma-separated base64: values (never log or expose).
INTEGRATIONS_PREVIOUS_KEYS=
# Durable integration delivery circuit breaker.
INTEGRATIONS_CIRCUIT_THRESHOLD=5
INTEGRATIONS_CIRCUIT_COOLDOWN_SECONDS=60
# Include all required existing provider hosts; custom Matomo/Plausible reporting hosts must be explicitly allowed.
# For Cloudflare reporting, include api.cloudflare.com when using a nonempty allowlist.
INTEGRATIONS_ALLOWED_HOSTS=

# Exact trusted HTTPS script/connect origins for optional consent-managed tags (comma-separated).
# Trusted HTTPS origins for custom tracking, including Matomo and self-hosted Plausible.
CONSENT_SCRIPT_ORIGINS=

# Optional trusted server analytics: comma-separated Integration Center UUIDs (empty disables).
ANALYTICS_SERVER_TARGETS=

# Read-only Analytics Hub (requires SQL migration 0015 and worker/scheduler)
ANALYTICS_REPORTING_ENABLED=true

# Migration Center: explicit source endpoint policy (empty denies external connections).
MIGRATION_DB_ALLOWED_ENDPOINTS=
MIGRATION_DB_TLS_CA=
MIGRATION_HTTP_ALLOWED_HOSTS=

# SkiF4er ID 1.5.2 — backend confidential OIDC client (off until explicitly configured)
# Register exact redirect URI: https://YOUR_CMS_DOMAIN/auth/oidc/callback
# Keycloak: realm skif4er, Standard flow ON, PKCE S256, client authentication ON.
SKIF4ER_ID_ENABLED=false
SKIF4ER_ID_CLIENT_ID=
SKIF4ER_ID_CLIENT_SECRET=
# Optional distinct 32-byte base64 encryption key, otherwise INTEGRATIONS_KEY / APP_KEY.
SKIF4ER_ID_TRANSACTION_KEY=
SKIF4ER_ID_TRANSACTION_PREVIOUS_KEYS=

# Explicit opt-in only. Never automatically merge accounts on matching email.
SKIF4ER_ID_AUTO_PROVISION=false

# Unified Session Management: idle sessions expire after 12 hours; absolute TTL remains SESSION_TTL_DAYS.
SESSION_IDLE_MINUTES=720

# SkiF4er ID global logout / Keycloak registration (no extra secrets):
# Valid post-logout redirect: https://YOUR_APP_HOST/auth/oidc/logout/complete
# Back-channel logout URL: https://YOUR_APP_HOST/auth/oidc/backchannel-logout

# SkiF4er ID OAuth Resource Server / external API access (1.5.5)
# OFF by default. Requires SKIF4ER_ID_ENABLED and a configured confidential client.
# Add an Audience mapper in Keycloak for the chosen API audience, and a client scope
# containing cajeer.api. Explicitly list clients whose tokens may call this API.
SKIF4ER_ID_API_ENABLED=false
SKIF4ER_ID_API_AUDIENCE=cajeerengine-api
SKIF4ER_ID_API_ALLOWED_CLIENTS=cajeerengine-web
SKIF4ER_ID_API_REQUIRED_SCOPE=cajeer.api
# Upper bound on the user's local RBAC (never '*' or implicit admin rights).
SKIF4ER_ID_API_MAX_PERMISSIONS=content:read,media:read,system:read
# Recommended true for immediate revocation; outage fails closed. False is offline JWT-only.
SKIF4ER_ID_API_INTROSPECTION=true

# 1.5.6 — browser step-up for high-risk identity/role/secret mutations.
# 60–900 seconds; defaults to 300. Evidence never survives session revocation/rotation.
AUTH_ASSURANCE_TTL_SECONDS=300
# Optional comma-delimited maximum permission scopes for OIDC browser sessions.
# Empty = only existing local RBAC; nonempty = local RBAC INTERSECT this ceiling.
# Claims realm_access / resource_access NEVER grant local roles.
SKIF4ER_ID_SESSION_MAX_PERMISSIONS=
