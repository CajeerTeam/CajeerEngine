APP_NAME=CajeerEngine
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_KEY=base64:CHANGE_ME
JWT_SECRET=CHANGE_ME
API_TOKEN_SECRET=CHANGE_ME
WEBHOOK_SIGNING_SECRET=CHANGE_ME
APP_LOCALE=ru

DB_DRIVER=pgsql
# Для demo/local можно поставить DB_DRIVER=sqlite и SQLITE_DATABASE=storage/database/cajeer.sqlite
SQLITE_DATABASE=storage/database/cajeer.sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cajeerengine
DB_USERNAME=cajeerengine
DB_PASSWORD=secret
DB_SSLMODE=prefer

# Optional DB drivers: mysql, mariadb
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci

CACHE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

QUEUE_DRIVER=file

SEARCH_DRIVER=file
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
OPENSEARCH_HOST=http://127.0.0.1:9200

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage/app
STORAGE_PUBLIC_UPLOADS_URL=/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true


RATE_LIMIT_GLOBAL=120
RATE_LIMIT_AUTH=20

APP_VERSION=1.1.1
LOG_RUNTIME=true
CONTENT_STORAGE=auto # auto: database after migrations, otherwise file fallback
CMS_STORAGE=auto # auto: database after migrations, otherwise file fallback

# Optional first admin for php bin/cajeer db:seed
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Security Core 0.5.0
SECURITY_REQUIRE_AUTH=true
SECURITY_PROTECT_CONTENT_WRITES=true
SECURITY_PROTECT_SYSTEM_ROUTES=true
RATE_LIMIT_WINDOW_SECONDS=60
SESSION_TTL_DAYS=14
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_MIXED=true
PASSWORD_ARGON2_MEMORY=65536
PASSWORD_ARGON2_TIME=4
PASSWORD_ARGON2_THREADS=2


# Admin UI 1.1.1
ADMIN_PUBLIC_BASE=/admin/
ADMIN_API_BASE=/api/v1
ADMIN_PREBUILT_ASSETS=true

# CMS Public Layer 1.1.1
PUBLIC_DEFAULT_TEMPLATE=default.page
TEMPLATE_CACHE=true
MEDIA_MAX_UPLOAD_MB=25
MEDIA_ALLOW_SVG=false


# Queue/Scheduler/Search/Webhooks 0.8.0
QUEUE_WORKER_LIMIT=10
QUEUE_RETRY_BACKOFF=60
RABBITMQ_DSN=amqp://guest:guest@127.0.0.1:5672/%2f
RABBITMQ_EXCHANGE=cajeerengine.jobs
RABBITMQ_QUEUE_PREFIX=cajeerengine
SEARCH_DRIVER=file
WEBHOOK_TIMEOUT_SECONDS=10
SCHEDULER_ENABLE_SEARCH_INDEX=true
SCHEDULER_ENABLE_WEBHOOK_DISPATCH=true


# Extension System 1.0.6
EXTENSIONS_ALLOW_UNSIGNED_IN_DEV=true
EXTENSIONS_REQUIRE_SIGNATURE=false
# Updates / Releases
# GitFlic endpoints are built into core for https://gitflic.ru/project/cajeerteam/cajeerengine
UPDATE_CHANNEL=stable
UPDATE_HTTP_TIMEOUT=5
UPDATE_SIGNATURE_REQUIRED=true
# Web Upgrade is disabled by default; prefer CLI update in production.
UPDATE_WEB_UPGRADE_ENABLED=false
UPDATE_WEB_UPGRADE_SECRET=change-me-long-random-secret

# Installer / Import Export
IMPORT_EXPORT_MAX_BYTES=52428800
